     dwb_sel_o, dwb_cyc_o, dwb_stb_o, dwb_ack_i, dwb_err_i, mdu_start,
     mdu_ack, mdu_funct3, mdu_operand_a, mdu_operand_b, mdu_busy,
     mdu_done, mdu_product, mdu_quotient, mdu_remainder, interrupts);
