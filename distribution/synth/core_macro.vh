       mdu_operand_b;
  output iwb_cyc_o, iwb_stb_o, dwb_we_o, dwb_cyc_o, dwb_stb_o,
       mdu_start, mdu_ack;
  output [3:0] dwb_sel_o;
  output [2:0] mdu_funct3;
