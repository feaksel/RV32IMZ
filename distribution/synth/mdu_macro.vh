module mdu_macro(clk, rst_n, start, ack, funct3, operand_a, operand_b,
     busy, done, product, quotient, remainder);
  input clk, rst_n, start, ack;
  input [2:0] funct3;
  input [31:0] operand_a, operand_b;
  output busy, done;
  output [63:0] product;
  output [31:0] quotient, remainder;
  wire clk, rst_n, start, ack;
  wire [2:0] funct3;
  wire [31:0] operand_a, operand_b;
  wire busy, done;
  wire [63:0] product;
  wire [31:0] quotient, remainder;
  mdu mdu_inst(.clk (clk), .rst_n (rst_n), .start (start), .ack (ack),
       .funct3 (funct3), .a (operand_a), .b (operand_b), .busy (busy),
       .done (done), .product (product), .quotient (quotient),
       .remainder (remainder));
endmodule

